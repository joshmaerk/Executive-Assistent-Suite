POST https://graph.microsoft.com/v1.0/me/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subject": "{{subject}}",
  "body": {
    "contentType": "HTML",
    "content": "{{body}}"
  },
  "toRecipients": [
    {
      "emailAddress": {
        "address": "{{recipient}}"
      }
    }
  ]
}
